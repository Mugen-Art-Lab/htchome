<Window x:Class="WeatherClockWidget.FullscreenAnimation.Raindrop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="this"
        Width="32" Height="32" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Loaded="this_Loaded">
    <Window.Resources>
        <Storyboard x:Key="MoveAnim">
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="Top" Duration="0:0:1.6" FillBehavior="Stop"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" BeginTime="0:0:1.2" FillBehavior="Stop" Completed="DoubleAnimation_Completed"/>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="{Binding ElementName=Scale, Path=ScaleX}"/>
        </Grid.RenderTransform>
        <Image Name="Image"/>
    </Grid>
</Window>
