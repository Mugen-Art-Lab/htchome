<UserControl x:Class="NewsWidget.NewsItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="10,3,10,3">
    <UserControl.Resources>
        <Storyboard x:Key="ExpandAnim">
            <DoubleAnimation Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="Height" From="0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Style TargetType="{x:Type Hyperlink}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#8fbf32" />
                </Trigger>
            </Style.Triggers>
            <Setter Property="Foreground" Value="#c1ff32" />
            <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="2"/>
        </Grid.RowDefinitions>
        <!--<Rectangle Name="UnreadMarker" HorizontalAlignment="Left" Width="18" RadiusX="5" RadiusY="5" ClipToBounds="True" Margin="-9,5,0,20" Opacity="0.8">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#c1ff32" Offset="0"/>
                    <GradientStop Color="#c1ff32" Offset="0.5"/>
                    <GradientStop Color="#8fbf32" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>-->
        <!--<StackPanel>
            <DockPanel Margin="20,0,10,0">
                <Image Name="HeaderIcon" Margin="0,5,5,0" DockPanel.Dock="Left" MaxWidth="60" MaxHeight="60" Stretch="UniformToFill" VerticalAlignment="Top"/>
                <TextBlock Name="Header" Margin="0,0,0,0"  Text="Header" Foreground="White" FontSize="16" TextWrapping="Wrap"  MouseLeftButtonDown="Header_MouseLeftButtonDown"/>
            </DockPanel>
            <DockPanel Margin="10,10,10,10" Name="ContentPanel" Visibility="Visible">
                <TextBlock Name="ContentBlock" Foreground="White" TextWrapping="Wrap" LineHeight="13"/>
            </DockPanel>
            <TextBlock Margin="20,0,10,0" FontFamily="pack://application:,,,/Fonts/#Droid Serif" Name="Footer" Text="Footer" Foreground="#b1b1b1" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <Rectangle Height="1" Fill="Gray" Margin="0,0,0,9" VerticalAlignment="Bottom"/>
            <Rectangle Height="1" Fill="Black" Margin="0,0,0,10" VerticalAlignment="Bottom"/>
        </StackPanel>-->
        <TextBlock Grid.Row="0" Name="TitleTextBlock" Text="Header" Foreground="White" FontWeight="Medium"  FontSize="16" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
        <DockPanel Grid.Row="1">
            <Image Name="IconImage" MaxWidth="50" Margin="0,0,5,0" Visibility="Collapsed"/>
            <TextBlock Name="ContentTextBlock" Text="Content" Foreground="White" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="150"/>
        </DockPanel>
        <Rectangle Grid.Row="3" Height="1" Fill="Gray" VerticalAlignment="Top" Margin="-10,0,-10,0"/>
        <Rectangle Grid.Row="3" Height="1" Fill="Black" VerticalAlignment="Bottom" Margin="-10,0,-10,0"/>
    </Grid>
</UserControl>
