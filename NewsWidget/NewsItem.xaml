<UserControl x:Class="NewsWidget.NewsItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Key="ExpandAnim">
            <DoubleAnimation Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="Height" From="0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="ContentPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Style TargetType="{x:Type Hyperlink}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#8fbf32" />
                </Trigger>
            </Style.Triggers>
            <Setter Property="Foreground" Value="#c1ff32" />
            <Setter Property="TextBlock.TextDecorations" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Rectangle Name="UnreadMarker" HorizontalAlignment="Left" Width="18" RadiusX="5" RadiusY="5" ClipToBounds="True" Margin="-9,5,0,20" Opacity="0.8">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#c1ff32" Offset="0"/>
                    <GradientStop Color="#c1ff32" Offset="0.5"/>
                    <GradientStop Color="#8fbf32" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <StackPanel>
            <DockPanel Margin="20,0,10,0">
                <Image Name="HeaderIcon" Margin="0,5,5,0" DockPanel.Dock="Left" MaxWidth="60" MaxHeight="60" Stretch="UniformToFill" VerticalAlignment="Top"/>
                <TextBlock Name="Header" Margin="0,0,0,0"  Text="Header" Foreground="White" FontSize="16" TextWrapping="Wrap"  MouseLeftButtonDown="Header_MouseLeftButtonDown"/>
            </DockPanel>
            <DockPanel Margin="10,10,10,10" Name="ContentPanel" Visibility="Collapsed">
                <Grid>
                    <FlowDocumentScrollViewer Name="ContentScrollViewer" VerticalScrollBarVisibility="Disabled" Foreground="White">
                        <FlowDocument Name="ContentDocument" Cursor="Arrow" FontFamily="Segoe UI" FontSize="14">
                        </FlowDocument>
                    </FlowDocumentScrollViewer>
                    <!--<Rectangle Fill="#00000000"/>-->
                    <!--<TextBlock Name="ContentTextShadow" Cursor="Hand" Text="{Binding ElementName=ContentText, Path=Text}" Margin="0,-1,0,0" FontSize="14" Foreground="Black" TextWrapping="Wrap" Opacity="0.5"/>
                <TextBlock Name="ContentText" Cursor="Hand" Text="Content" Margin="0,0,0,0" FontSize="14" Foreground="White" TextWrapping="Wrap"/>-->
                </Grid>
            </DockPanel>
            <TextBlock Margin="20,0,10,0" FontFamily="pack://application:,,,/Fonts/#Droid Serif" Name="Footer" Text="Footer" Foreground="#b1b1b1" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <Rectangle Height="1" Fill="#8d8e8f" Margin="0,10,0,10"/>
        </StackPanel>
    </Grid>
</UserControl>
