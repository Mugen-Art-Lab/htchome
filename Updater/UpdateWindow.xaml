<Window x:Class="Updater.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UpdaterTitle}" Height="140" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <ResourceDictionary x:Name="Locale"/>
    </Window.Resources>
    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#e3e7ec" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock Name="MessageText" Text="There is {0} available. Would you like to update?" Margin="10" TextWrapping="Wrap"/>
        <ProgressBar Name="DownloadProgress" Height="15" Margin="10" Visibility="Hidden"/>
        <Button Name="YesButton" Width="75" Height="23" Content="{DynamicResource Yes}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,95,10" Click="YesButton_Click"/>
        <Button Name="NoButton" Width="75" Height="23" Content="{DynamicResource No}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10" Click="NoButton_Click"/>
    </Grid>
</Window>
