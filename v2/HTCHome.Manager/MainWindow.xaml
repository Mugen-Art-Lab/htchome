<Window x:Class="HTCHome.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HTC Home Mugen Manager" Height="500" Width="980" MinHeight="430" MinWidth="880"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="HTC Home Mugen Manager" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Opacity="0.7" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,3,0,0">
                <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="LanguageBox" Width="100" SelectionChanged="LanguageBox_SelectionChanged">
                    <ComboBoxItem Content="Русский" Tag="ru-RU" />
                    <ComboBoxItem Content="English" Tag="en-US" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="ManagerAutoStartCheckBox" Click="ManagerAutoStartCheckBox_Click" Margin="0,0,18,0" />
                    <CheckBox x:Name="ProfileAutoStartCheckBox" Click="ProfileAutoStartCheckBox_Click" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StartAllButton" Width="110" Margin="0,0,8,0" Click="StartAllButton_Click" />
                    <Button x:Name="StopAllButton" Width="110" Click="StopAllButton_Click" />
                </StackPanel>
            </Grid>
            <!-- Run #58: the validated resume guard is now normal profile behavior.
                 Keep these named controls instantiated but hidden so old Manager code
                 and profile configuration remain binary/config compatible. -->
            <Grid Margin="0,0,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ResumeDiagnosticLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ResumeDiagnosticBox" Grid.Column="1" Width="340" SelectionChanged="ResumeDiagnosticBox_SelectionChanged">
                    <ComboBoxItem x:Name="ResumeNormalItem" Tag="normal" />
                    <ComboBoxItem x:Name="ResumeHideItem" Tag="target0" />
                    <ComboBoxItem x:Name="ResumeCloakItem" Tag="target3" Visibility="Collapsed" />
                    <ComboBoxItem x:Name="ResumeMinimizeItem" Tag="target12" Visibility="Collapsed" />
                </ComboBox>
                <TextBlock x:Name="ResumeDiagnosticHint" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.65" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="NvidiaCompatibilityButton" Width="180" HorizontalAlignment="Left" Click="NvidiaCompatibilityButton_Click" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AddButton" Width="100" Margin="0,0,8,0" Click="AddButton_Click" />
                    <Button x:Name="RenameButton" Width="110" Margin="0,0,8,0" Click="RenameButton_Click" />
                    <Button x:Name="StartButton" Width="95" Margin="0,0,8,0" Click="StartButton_Click" />
                    <Button x:Name="StopButton" Width="95" Margin="0,0,8,0" Click="StopButton_Click" />
                    <Button x:Name="DeleteButton" Width="85" Click="DeleteButton_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid>
            <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" />
            <ListView x:Name="ProfilesList" Margin="1" SelectionChanged="ProfilesList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="NameColumn" Width="300"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" HorizontalAlignment="Stretch" TextAlignment="Left" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn x:Name="StatusColumn" Width="160"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" HorizontalAlignment="Stretch" TextAlignment="Center" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn x:Name="AutoStartColumn" Width="160"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding AutoStartText}" HorizontalAlignment="Stretch" TextAlignment="Center" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn x:Name="ResumeDiagnosticColumn" Width="0"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ResumeDiagnosticText}" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="ID" Width="180"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ShortId}" HorizontalAlignment="Stretch" TextAlignment="Center" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
