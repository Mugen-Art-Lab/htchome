<UserControl x:Class="Clock.WeatherAnimation.Raindrop2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="this" Loaded="this_Loaded" >
    <UserControl.Resources>
        <Storyboard x:Key="MoveAnim">
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="(Canvas.Top)" To="200" Completed="DoubleAnimation_Completed" FillBehavior="Stop" AccelerationRatio="0.3"/>
        </Storyboard>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1" Completed="DoubleAnimation_Completed_1" FillBehavior="Stop"/>
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <Image Name="Image" Stretch="Uniform" Source="/UIFramework.Weather;component/Images/layer_drop1.png"/>
    </Grid>
</UserControl>
