<UserControl x:Class="Clock.WeatherAnimation.RainCloud"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="this"
             Loaded="UserControl_Loaded" RenderTransformOrigin="0.5,0.5" Opacity="0">
    <UserControl.Resources>
        <Storyboard x:Key="FadeInL" BeginTime="0:0:1.2">
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="Opacity" From="0" To="0.95" Duration="0:0:0.3" Completed="DoubleAnimation_Completed_1"/>
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="(Canvas.Left)" From="90" To="60" Duration="0:0:0.8" DecelerationRatio="0.3"/>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" From="0.65" To="0.7" Duration="0:0:0.5" AccelerationRatio="0.3"/>
        </Storyboard>
        <Storyboard x:Key="FadeInR" BeginTime="0:0:1.2">
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="Opacity" From="0" To="0.95" Duration="0:0:0.3" Completed="DoubleAnimation_Completed_1"/>
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="(Canvas.Left)" From="150" To="180" Duration="0:0:0.8" DecelerationRatio="0.3"/>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" From="0.65" To="0.7" Duration="0:0:0.5" AccelerationRatio="0.3"/>
        </Storyboard>
        <Storyboard x:Key="FadeOutL">
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5" BeginTime="0:0:33"/>
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="(Canvas.Left)" From="60" To="0" Duration="0:0:3.5" BeginTime="0:0:32"/>
        </Storyboard>
        <Storyboard x:Key="FadeOutR">
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5" BeginTime="0:0:33"/>
            <DoubleAnimation Storyboard.TargetName="this" Storyboard.TargetProperty="(Canvas.Left)" From="180" To="240" Duration="0:0:3.5" BeginTime="0:0:32"/>
        </Storyboard>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="Scale" ScaleX="0.7" ScaleY="{Binding ElementName=Scale, Path=ScaleX}"/>
    </UserControl.RenderTransform>
    <Grid>
        <Image Name="Image" RenderTransformOrigin="0.5,0.5"/>
    </Grid>
</UserControl>
