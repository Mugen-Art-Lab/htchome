<UserControl x:Class="Clock.Controls.WideForecastItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,0,5"
             Loaded="UserControlLoaded" MouseLeftButtonDown="UserControlMouseLeftButtonDown" MouseLeftButtonUp="UserControlMouseLeftButtonUp">
    <DockPanel>
        <TextBlock Name="DayName" Text="mon" Foreground="LightGray" Margin="0,-10,0,3" FontSize="12" HorizontalAlignment="Center" DockPanel.Dock="Bottom">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="0.5" BlurRadius="2" Opacity="0.7"/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock Name="Temperature" Margin="7,18,5,0" FontSize="14" DockPanel.Dock="Right" VerticalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="0.5" BlurRadius="2" Opacity="0.7"/>
            </TextBlock.Effect><Run Name="High" Foreground="White" Text="0°"/><LineBreak/><Run Name="Low" Foreground="LightGray" Text="0°"/>
        </TextBlock>
        <Image Name="Icon" Source="/UIFramework.Weather;Component/Images/weather_1.png" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
                <TranslateTransform x:Name="Transform"/>
            </Image.RenderTransform>
            <Image.Resources>
                <Storyboard x:Key="FlipAnim1">
                    <DoubleAnimation x:Name="TransformAnim1" Storyboard.TargetName="Transform" Storyboard.TargetProperty="Y" From="0" To="10" Duration="0:0:0.3" Completed="DoubleAnimationCompleted"/>
                    <DoubleAnimation x:Name="OpacityAnim1" Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                </Storyboard>
                <Storyboard x:Key="FlipAnim2">
                    <DoubleAnimation x:Name="TransformAnim2" Storyboard.TargetName="Transform" Storyboard.TargetProperty="Y" From="-10" To="0" Duration="0:0:0.3"/>
                    <DoubleAnimation x:Name="OpacityAnim2" Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </Image.Resources>
        </Image>
    </DockPanel>
</UserControl>
