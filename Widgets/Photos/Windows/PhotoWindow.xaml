<Window x:Class="Photos.Windows.PhotoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:Controls="clr-namespace:Photos.Controls"
        Title="PhotoWindow" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        MouseMove="WindowMouseMove" Loaded="WindowLoaded" SourceInitialized="WindowSourceInitialized" Opacity="0">
    <Window.Resources>
        <Storyboard x:Key="FadeInAnim" BeginTime="0:0:0.5">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetProperty="Left" Duration="0:0:0.5" AccelerationRatio="0.3" DecelerationRatio="0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="Top" Duration="0:0:0.5" AccelerationRatio="0.3" DecelerationRatio="0.3"/>
        </Storyboard>
    </Window.Resources>
    <Canvas Name="Root" Margin="25">
        <!--<Controls:PhotoControl/>-->
    </Canvas>
</Window>
