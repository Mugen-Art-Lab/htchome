<Application x:Class="News.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Windows/ClassicNews.xaml"
             Startup="ApplicationStartup" Exit="ApplicationExit" DispatcherUnhandledException="ApplicationDispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Home.Base;component/Resources/TabControlGlass.xaml"/>
                <ResourceDictionary Source="/Home.Base;component/Resources/WeatherRefreshProgressBar.xaml"/>
                <ResourceDictionary Source="/Home.Base;component/Resources/StyleItemRadioButton.xaml"/>
                <ResourceDictionary Source="/Home.Base;component/Resources/Colors.xaml"/>
                <ResourceDictionary>
                    <DataTemplate x:Key="OverlayIcon">
                        <Grid Width="20" Height="20">
                            <Ellipse Fill="Green" Stroke="White" StrokeThickness="1"/>
                            <Viewbox Height="16" VerticalAlignment="Center" Margin="3">
                                <TextBlock Text="{Binding}" TextAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </Viewbox>
                        </Grid>
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
