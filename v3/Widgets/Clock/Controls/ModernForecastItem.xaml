<UserControl x:Class="Clock.Controls.ModernForecastItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="60" Margin="0,0,0,5"
             Loaded="UserControlLoaded" MouseLeftButtonDown="UserControlMouseLeftButtonDown" MouseLeftButtonUp="UserControlMouseLeftButtonUp">
    <StackPanel Orientation="Vertical">
        <Image Name="Icon" Source="/UIFramework.Weather;Component/Images/weather_1.png" Margin="3,-4,3,0" RenderOptions.BitmapScalingMode="HighQuality" Height="60">
            <Image.RenderTransform>
                <TranslateTransform x:Name="Transform"/>
            </Image.RenderTransform>
            <Image.Resources>
                <Storyboard x:Key="FlipAnim1">
                    <DoubleAnimation x:Name="TransformAnim1" Storyboard.TargetName="Transform" Storyboard.TargetProperty="Y" From="0" To="10" Duration="0:0:0.3" Completed="DoubleAnimationCompleted"/>
                    <DoubleAnimation x:Name="OpacityAnim1" Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                </Storyboard>
                <Storyboard x:Key="FlipAnim2">
                    <DoubleAnimation x:Name="TransformAnim2" Storyboard.TargetName="Transform" Storyboard.TargetProperty="Y" From="-10" To="0" Duration="0:0:0.3"/>
                    <DoubleAnimation x:Name="OpacityAnim2" Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </Image.Resources>
        </Image>
        <TextBlock Name="Temperature" Margin="0,-8,0,0" FontSize="12" HorizontalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="0.5" BlurRadius="2" Opacity="0.7"/>
            </TextBlock.Effect>
            <Run Name="High" Foreground="White" Text="0°"/><Run Foreground="LightGray" Text="/"/><Run Name="Low" Foreground="LightGray" Text="0°"/>
        </TextBlock>
        <TextBlock Name="DayName" Text="mon" Foreground="LightGray" Margin="0,-2,0,0" FontSize="11" HorizontalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="0.5" BlurRadius="2" Opacity="0.7"/>
            </TextBlock.Effect>
        </TextBlock>
    </StackPanel>
</UserControl>
