<Window x:Class="News.Windows.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="395" Width="450" Background="Transparent"
        SourceInitialized="WindowSourceInitialized" Closing="WindowClosing">
    <Grid>
        <Rectangle Fill="Black" Margin="3" RadiusX="3" RadiusY="3" Opacity="0.7">
            <Rectangle.Effect>
                <BlurEffect />
            </Rectangle.Effect>
        </Rectangle>
        <Rectangle Fill="#9ea0a4" Margin="2" RadiusX="3" RadiusY="3"/>
        <DockPanel Margin="3">
            <Border DockPanel.Dock="Top" Background="LightGray" CornerRadius="3,3,0,0">
                <TextBlock Name="TitleBox" FontSize="16" Margin="10" TextWrapping="WrapWithOverflow" Cursor="Hand" MouseLeftButtonUp="TitleBoxMouseLeftButtonUp"/>
            </Border>
            <WebBrowser Name="Browser"/>
        </DockPanel>
    </Grid>
</Window>
