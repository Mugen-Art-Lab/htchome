<UserControl x:Class="BookmarksWidget.BookmarkVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="150"
             Loaded="UserControl_Loaded">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Name="ChangeItem" Header="Change" Click="ChangeItem_Click"/>
            <MenuItem Name="ClearItem" Header="Clear" Click="ClearItem_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Grid Margin="3">
        <Image Name="Icon" Source="Resources\thumbnail_addbookmark.png" Stretch="UniformToFill"/>
    </Grid>
</UserControl>
