<UserControl x:Class="BookmarksWidget.Bookmarks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:this="clr-namespace:BookmarksWidget"
             Width="311" Height="430" Loaded="UserControl_Loaded">
    <Grid Margin="0,10,0,0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="{Binding ElementName=Scale, Path=ScaleX}"/>
        </Grid.RenderTransform>
        <Rectangle Name="BgRect" Fill="White"  Margin="0,25,0,8" Opacity="1"/>
        <Image Name="Body" Source="Resources\body.png" Stretch="Fill" Margin="0,25,0,8"/>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <WrapPanel Name="BookmarksGrid" Margin="5,45,5,20" MouseLeftButtonDown="BookmarksGrid_MouseLeftButtonDown">
                <this:BookmarkVisual />
                <this:BookmarkVisual />
                <this:BookmarkVisual />
                <this:BookmarkVisual />
                <this:BookmarkVisual />
                <this:BookmarkVisual />
            </WrapPanel>
        </ScrollViewer>
        <Image Name="Header" Source="Resources\header.png" VerticalAlignment="Top" Stretch="Uniform" />
        <Image Name="HeaderShadow" Source="Resources\header_shadow.png" VerticalAlignment="Top" Stretch="Uniform" Margin="0,45,0,0"/>
        <TextBlock Name="HeaderTextBlock" Foreground="White" Text="Bookmarks" VerticalAlignment="Top" FontSize="18" Margin="10,12,0,0"/>
        <Image Name="EarthIcon" Source="/Bookmarks;component/Resources/EarthIconAnimation/earth_rotate_0000.png" VerticalAlignment="Top" HorizontalAlignment="Right" Width="102" Height="67" Margin="0,-15,10,0">
        </Image>
        <Image Name="Footer" Source="Resources\footer.png" VerticalAlignment="Bottom" Height="22"/>
    </Grid>
</UserControl>
