<Window x:Class="WebInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Title}" Height="320" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing" Background="#e3e7ec">
    <Grid Name="MainGrid">
        <Grid Margin="0,0,0,40">
            <Rectangle Margin="0,0,0,0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.9"/>
                        <GradientStop Color="#e5e9ee" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="#8b9097" VerticalAlignment="Bottom" Height="1" Margin="0,0,0,4"/>
            <Image Source="Resources/bg.png" Stretch="UniformToFill" HorizontalAlignment="Center"/>
            <Rectangle VerticalAlignment="Bottom" Height="4">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#c6c9cd" Offset="0"/>
                        <GradientStop Color="#e3e7ec" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid Name="ProgressGrid" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <TextBlock Name="StatusTextBlock" Text="{DynamicResource Connecting}" Margin="10,20,10,40" Height="25"/>
            <ProgressBar Name="DownloadProgress" Height="15" Margin="10,10,10,0" IsIndeterminate="True" Background="Transparent"/>
        </Grid>
        <Grid Name="InstallGrid" VerticalAlignment="Bottom" Margin="0,0,0,20" Visibility="Hidden">
            <TextBlock Name="InstallPathTextBlock" Text="{DynamicResource InstallPath}" Margin="10,0,10,50" Height="25"/>
            <DockPanel Margin="10,0,10,10"  Height="22">
                <Button DockPanel.Dock="Right" Name="ChangeDirButton" Content="{DynamicResource Change}" Width="30" Click="ChangeDirButton_Click"/>
                <TextBox Name="InstallPath" Margin="0,0,5,0"/>
            </DockPanel>
        </Grid>
        <CheckBox Name="LaunchCheckBox" Content="{DynamicResource Launch}" VerticalAlignment="Bottom" Margin="10,0,10,10" Visibility="Hidden"/>
        <Button Name="CloseButton" Content="{DynamicResource Close}" Width="90" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" IsEnabled="False" Click="CloseButton_Click" Visibility="Collapsed"/>
        <Button Name="InstallButton" Content="{DynamicResource Install}" Width="90" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,110,10" Click="InstallButton_Click"/>
        <Button Name="CancelButton" Content="{DynamicResource Cancel}" Width="90" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,10,10" Click="InstallButton_Click"/>
        <Button Name="ParametersButton" Content="{DynamicResource Options}" Width="90" Height="25" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"/>
    </Grid>
</Window>
