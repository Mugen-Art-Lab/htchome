<UserControl x:Class="WebInstaller.Pages.InstallCancelPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="420">
<Grid>
        <Grid Margin="0,0,0,40">
            <Rectangle Fill="#8b9097" VerticalAlignment="Bottom" Height="1" Margin="0,0,0,4"/>
            <Image Source="../Resources/bg.png" Stretch="UniformToFill" HorizontalAlignment="Center"/>
            <Rectangle VerticalAlignment="Bottom" Height="4">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#c6c9cd" Offset="0"/>
                        <GradientStop Color="#e3e7ec" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock Name="StatusTextBlock" Text="{DynamicResource InstallationCancelled}" Margin="10" VerticalAlignment="Bottom"/>
        </Grid>
        <Button Name="CancelButton" Content="{DynamicResource Close}" Width="100" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,10,10" Click="CancelButton_Click"/>
    </Grid>
</UserControl>
