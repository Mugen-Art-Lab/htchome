<Window x:Class="WebInstaller.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UninstallTitle}" Height="120" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <ResourceDictionary x:Name="Locale"/>
    </Window.Resources>
    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#e3e7ec" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock Name="MessageTextBlock" Text="{DynamicResource Uninstall}" Margin="10"/>
        <Button Name="OkButton" Width="75" Height="23" Content="{DynamicResource OK}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,95,10" Click="OkButton_Click"/>
        <Button Name="CancelButton" Width="75" Height="23" Content="{DynamicResource Cancel}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10" Click="CancelButton_Click"/>
    </Grid>
</Window>
